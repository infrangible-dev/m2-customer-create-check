{
    "name": "infrangible/m2-customer-create-check",
    "description": "Blocks spam registrations by checking name and address fields of new customer accounts against allow and deny patterns; web addresses in names are rejected by default.",
    "type": "magento2-module",
    "version": "1.0.1",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Customers",
        "block spam registrations",
        "customer registration spam filter",
        "fake account protection"
    ],
    "homepage": "https://github.com/infrangible-dev/m2-customer-create-check",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=7.1",
        "magento/framework": "~101.0.0|~102.0.0|~103.0.0",
        "infrangible/m2-foundation": "~2.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CustomerCreateCheck\\": "src"
        }
    }
}
